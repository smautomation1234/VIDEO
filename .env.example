# Vertex AI creates the script and prompt plan using the same billed Google
# Cloud project and service-account authentication used by Omni.
# Optional override for the script-planning model.
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite

# Vertex AI Agent Platform model used for Omni video generation.
GEMINI_OMNI_MODEL=gemini-omni-flash-preview

# Google Cloud project used for script planning and Vertex Omni access.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Base64-encoded Google service-account JSON for Vercel.
# For local development, this may be omitted when Application Default
# Credentials are already configured.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use the current sb_secret_... server key. Existing projects may temporarily
# use SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Generate one strong random value (at least 32 characters). Use the identical
# value in Vercel and in Supabase Vault when configuring Supabase Cron.
CRON_SECRET=
